# Copy to .env before running: cp .env.example .env
#
# Every value has a working default in src/config.js except JWT_SECRET, which
# the server refuses to start without in production.

DATABASE_URL="file:./dev.db"
PORT=4000
NODE_ENV=development

# Generate a real one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="7d"

# Origin allowed to call the API.
CLIENT_ORIGIN="http://localhost:5173"
